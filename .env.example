# Supabase PostgreSQL connection string
# For app connections (session-mode pooler):
DATABASE_URL=postgresql+psycopg://postgres.{ref}:{password}@aws-0-{region}.pooler.supabase.com:5432/{db}

# For Alembic migrations (direct connection, not through pooler):
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.{ref}:{password}@db.{ref}.supabase.co:5432/postgres

# Optional: separate test database
# TEST_DATABASE_URL=postgresql+psycopg://...

# Google Places API key (for store discovery)
# GOOGLE_PLACES_API_KEY=your-key-here

# Anthropic API key (for LLM-based validation)
# ANTHROPIC_API_KEY=sk-ant-...

# Max LLM spend per validation run (in cents, default 500)
# LLM_BUDGET_CENTS=500
